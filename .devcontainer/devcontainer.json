{
  "name": "Plataforma Criptomoeda",
  "image": "ghcr.io/codesandbox/devcontainers/typescript-node:latest",
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {},
    "ghcr.io/devcontainers/features/git:1": {},
    "ghcr.io/devcontainers/features/node:1": {},
    "ghcr.io/codesandbox/devcontainer-features/codesandbox:0.1.4": {}
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint"
      ]
    }
  },
  "remoteUser": "root",
  "postCreateCommand": "apt-get update && apt-get install -y adb"
}
